{
  "name": "local-latex-resume-editor",
  "version": "0.10.0",
  "private": true,
  "main": "desktop/main.cjs",
  "description": "A local CV editor, resume coach, and mock interview workspace.",
  "scripts": {
    "build": "npm run build:pdf-assets && npm run build:pdf-worker && esbuild public/app.js --bundle --outfile=public/app.bundle.js --format=iife --platform=browser --minify --sourcemap",
    "build:pdf-assets": "node scripts/build-pdf-assets.mjs",
    "build:pdf-worker": "esbuild node_modules/pdfjs-dist/build/pdf.worker.min.mjs --bundle --outfile=public/pdf.worker.min.mjs --format=esm --platform=browser --minify",
    "prestart": "npm run build",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop:dev": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.33",
    "@ai-sdk/openai": "^4.0.32",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "ai": "^7.0.55",
    "codemirror": "^6.0.2",
    "diff": "^8.0.3",
    "interactjs": "^1.10.28",
    "lucide": "^1.29.0",
    "motion": "^13.0.0",
    "pdfjs-dist": "5.4.624",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.cvstudio.desktop",
    "productName": "CV Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "public/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "server.js",
      "agent-runtime.mjs",
      "intake-runtime.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/tectonic",
        "to": "vendor/tectonic"
      },
      {
        "from": "workspace",
        "to": "default-workspace",
        "filter": [
          "**/*",
          "!**/.cvstudio.json",
          "!**/.cvstudio-bank/**",
          "!**/*.aux",
          "!**/*.log",
          "!**/*.pdf"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "desktop/assets/icon-1024.png",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "CV Studio ${version}",
      "artifactName": "CV-Studio-${version}-${arch}.${ext}"
    },
    "artifactName": "CV-Studio-${version}-${arch}.${ext}"
  }
}
